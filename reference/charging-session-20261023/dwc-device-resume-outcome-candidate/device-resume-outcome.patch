+static void dwc3_gadget_resume_device(struct dwc3 *dwc,
+				      struct dwc3_device_resume_result *result)
+{
+	unsigned long flags;
+
+	*result = (struct dwc3_device_resume_result) {
+		.requested = true,
+		.detail.stage = "initial-connect",
+	};
+	mutex_lock(&dwc->connect_mutex);
+	spin_lock_irqsave(&dwc->lock, flags);
+	result->detail.start_seq = dwc->err_event_seq;
+	result->detail.end_seq = result->detail.start_seq;
+	spin_unlock_irqrestore(&dwc->lock, flags);
+	/* Preserve the original first attempt, even with an old error state.
+	 * Only the synchronous recovery claim refuses to revive it.
+	 */
+	result->primary = dwc3_gadget_soft_connect(dwc);
+	if (result->primary) {
+		result->recovery_attempted = true;
+		result->recovery = dwc3_gadget_recover_locked(dwc, true,
+							 &result->detail);
+		result->operation_completed = result->detail.reconnected &&
+			!result->detail.pending &&
+			!pm_runtime_suspended(dwc->dev);
+		dev_err(dwc->dev,
+			"DEVICE resume primary=%d recovery=%d stage=%s seq=%llu->%llu pending_at_publish=%u\n",
+			result->primary, result->recovery, result->detail.stage,
+			(unsigned long long)result->detail.start_seq,
+			(unsigned long long)result->detail.end_seq,
+			result->detail.pending);
+	} else {
+		spin_lock_irqsave(&dwc->lock, flags);
+		result->detail.end_seq = dwc->err_event_seq;
+		result->detail.pending = result->detail.end_seq !=
+			result->detail.start_seq;
+		result->detail.reconnected = true;
+		result->detail.stage = "initial-connect-complete";
+		/* A zero primary does not clear an older failure or queued
+		 * recovery. This is a publication snapshot, not exclusion of
+		 * future IRQ/work or permission for core/PHY teardown.
+		 */
+		result->operation_completed = !result->detail.pending &&
+			dwc->err_state == DWC3_ERR_NONE &&
+			!pm_runtime_suspended(dwc->dev);
+		spin_unlock_irqrestore(&dwc->lock, flags);
+	}
+	mutex_unlock(&dwc->connect_mutex);
+}
+
+/* Internal same-Image DEVICE interface. The caller must retain the bound
+ * controller and powered core/PHY for the complete synchronous operation.
+ * No result here supplies failed-attempt abort or PM-unwind ownership.
+ */
+void dwc3_gadget_resume_result(struct dwc3 *dwc,
+			       struct dwc3_device_resume_result *result)
+{
+	*result = (struct dwc3_device_resume_result) {
+		.detail.stage = "not-requested",
+	};
+	if (!dwc->gadget_driver || !dwc->softconnect)
+		return;
+	if (dwc->current_dr_role != DWC3_GCTL_PRTCAP_DEVICE) {
+		result->primary = -EOPNOTSUPP;
+		result->detail.stage = "not-device";
+		return;
+	}
+	dwc3_gadget_resume_device(dwc, result);
+}
