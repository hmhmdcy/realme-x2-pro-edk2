    "Documentation/kbuild/reproducible-builds.rst": {
      "sha256": "b7aed70fd079216a968b65030626ffb929e75e983f7e3048fa4a24a7b2a930c1",
      "lines": [
        {
          "line": 20,
          "text": ""
        },
        {
          "line": 21,
          "text": "* The version string exposed by ``uname()`` and included in"
        },
        {
          "line": 22,
          "text": "  ``/proc/version``"
        },
        {
          "line": 23,
          "text": ""
        },
        {
          "line": 24,
          "text": "* File timestamps in the embedded initramfs"
        },
        {
          "line": 25,
          "text": ""
        },
        {
          "line": 26,
          "text": "* If enabled via ``CONFIG_IKHEADERS``, file timestamps of kernel"
        },
        {
          "line": 27,
          "text": "  headers embedded in the kernel or respective module,"
        },
        {
          "line": 28,
          "text": "  exposed via ``/sys/kernel/kheaders.tar.xz``"
        },
        {
          "line": 29,
          "text": ""
        },
        {
          "line": 30,
          "text": "By default the timestamp is the current time and in the case of"
        },
        {
          "line": 31,
          "text": "``kheaders`` the various files' modification times. This must"
        },
        {
          "line": 32,
          "text": "be overridden using the `KBUILD_BUILD_TIMESTAMP`_ variable."
        },
        {
          "line": 33,
          "text": "If you are building from a git commit, you could use its commit date."
        },
        {
          "line": 34,
          "text": ""
        },
        {
          "line": 35,
          "text": "The kernel does *not* use the ``__DATE__`` and ``__TIME__`` macros,"
        },
        {
          "line": 36,
          "text": "and enables warnings if they are used.  If you incorporate external"
        },
        {
          "line": 37,
          "text": "code that does use these, you must override the timestamp they"
        },
        {
          "line": 38,
          "text": "correspond to by setting the `SOURCE_DATE_EPOCH`_ environment"
        },
        {
          "line": 39,
          "text": "variable."
        },
        {
          "line": 40,
          "text": ""
        },
        {
          "line": 41,
          "text": "User, host"
        },
        {
          "line": 42,
          "text": "----------"
        },
        {
          "line": 43,
          "text": ""
        },
        {
          "line": 44,
          "text": "The kernel embeds the building user and host names in"
        }
      ]
    }
