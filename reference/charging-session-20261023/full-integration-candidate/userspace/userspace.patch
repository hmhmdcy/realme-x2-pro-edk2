+def valid_service_request(name, value):
+    if name == 'charge_behaviour':
+        return value == 'auto'
+    bounds = {'input_current_limit': (50000, 2000000),
+              'constant_charge_current': (200000, 1100000)}
+    if name not in bounds or not isinstance(value, str):
+        return False
+    try:
+        number = int(value)
+    except ValueError:
+        return False
+    return str(number) == value and bounds[name][0] <= number <= bounds[name][1]
+
