
config USB_DWC3_SAMURAI_APSD_OWNER
	bool "Samurai APSD DWC lifecycle candidate (no attempt gate yet)"
	depends on USB_DWC3=y && USB_DWC3_GADGET
	depends on SERIAL_EUD_CONSOLE=y && PHY_QCOM_USB_SNPS_FEMTO_V2=y
	depends on POWER_SUPPLY=y
	default n
	help
	  Internal optional coordinator, additionally requiring the explicit
	  samurai,apsd-owner property. Missing PD/route and EUD/PHY lifetime
	  coverage refuses every hardware attempt. Not a deployable rerun path.
