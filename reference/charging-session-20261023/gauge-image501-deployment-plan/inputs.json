        {
          "line": 14,
          "text": "/*"
        },
        {
          "line": 15,
          "text": " * The maximum module name length, including the NUL byte."
        },
        {
          "line": 16,
          "text": " * Chosen so that structs with an unsigned long line up, specifically"
        },
        {
          "line": 17,
          "text": " * modversion_info."
        },
        {
          "line": 18,
          "text": " */"
        },
        {
          "line": 19,
          "text": "#define __MODULE_NAME_LEN (64 - sizeof(unsigned long))"
        },
        {
          "line": 20,
          "text": ""
        },
        {
          "line": 21,
          "text": "/* You can override this manually, but generally this should match the"
        },
        {
          "line": 22,
          "text": "   module name. */"
        },
        {
          "line": 23,
          "text": "#ifdef MODULE"
        },
        {
          "line": 24,
          "text": "#define MODULE_PARAM_PREFIX /* empty */"
        },
        {
          "line": 25,
          "text": "#define __MODULE_INFO_PREFIX /* empty */"
        },
        {
          "line": 26,
          "text": "#else"
        },
        {
          "line": 27,
          "text": "#define MODULE_PARAM_PREFIX KBUILD_MODNAME \".\""
        },
        {
          "line": 28,
          "text": "/* We cannot use MODULE_PARAM_PREFIX because some modules override it. */"
        },
        {
          "line": 29,
          "text": "#define __MODULE_INFO_PREFIX KBUILD_MODNAME \".\""
        },
        {
          "line": 30,
          "text": "#endif"
        },
        {
          "line": 31,
          "text": ""
        },
        {
          "line": 32,
          "text": "/* Generic info of form tag = \"info\" */"
        },
        {
          "line": 33,
          "text": "#define MODULE_INFO(tag, info)\t\t\t\t\t  \\"
        },
        {
          "line": 34,
          "text": "\tstatic_assert(\t\t\t\t\t\t  \\"
        },
        {
          "line": 35,
          "text": "\t\tsizeof(info) - 1 == __builtin_strlen(info),\t  \\"
        },
        {
          "line": 36,
          "text": "\t\t\"MODULE_INFO(\" #tag \", ...) contains embedded NUL byte\"); \\"
        },
        {
          "line": 37,
          "text": "\tstatic const char __UNIQUE_ID(modinfo)[]\t\t\t  \\"
        },
        {
          "line": 38,
          "text": "\t\t__used __section(\".modinfo\") __aligned(1)\t\t  \\"
        },
        {
          "line": 39,
          "text": "\t\t= __MODULE_INFO_PREFIX __stringify(tag) \"=\" info"
        },
        {
          "line": 40,
          "text": ""
        },
        {
          "line": 41,
          "text": "#define __MODULE_PARM_TYPE(name, _type)\t\t\t\t\t  \\"
        },
        {
          "line": 42,
          "text": "\tMODULE_INFO(parmtype, #name \":\" _type)"
