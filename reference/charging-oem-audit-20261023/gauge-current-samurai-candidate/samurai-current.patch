+static int bq27xxx_samurai_average_current(struct bq27xxx_device_info *di,
+					 union power_supply_propval *val)
+{
+	int raw;
+
+	if (!bq27xxx_samurai_instant(di))
+		return -EINVAL;
+	raw = bq27xxx_read(di, BQ27XXX_REG_AI, false);
+	if (raw < 0)
+		return raw;
+	val->intval = (int)((s16)raw) * 1000;
+	return 0;
+}
