+/* Software allowance revocation during system PM is not a physical wake
+ * event. Serialize publication with prepare/complete; the IRQ path below
+ * still reports real connector events independently of this deferred notice.
+ */
+static void samurai_usb_changed(struct samurai_usb_input *input)
+{
+	mutex_lock(&input->lock);
+	if (input->pm_prepared)
+		input->notify_pending = true;
+	else
+		power_supply_changed(input->psy);
+	mutex_unlock(&input->lock);
+}
