-static DEFINE_SIMPLE_DEV_PM_OPS(samurai_usb_pm_ops, samurai_usb_suspend, samurai_usb_resume);
+static int samurai_usb_prepare(struct device *dev)
+{
+	struct samurai_usb_input *input = dev_get_drvdata(dev);
+
+	mutex_lock(&input->lock);
+	input->pm_prepared = true;
+	mutex_unlock(&input->lock);
+	return 0;
+}
+
+static void samurai_usb_complete(struct device *dev)
+{
+	struct samurai_usb_input *input = dev_get_drvdata(dev);
+
+	mutex_lock(&input->lock);
+	input->pm_prepared = false;
+	if (input->notify_pending) {
+		input->notify_pending = false;
+		power_supply_changed(input->psy);
+	}
+	mutex_unlock(&input->lock);
+}
+
+static const struct dev_pm_ops samurai_usb_pm_ops = {
+	.prepare = pm_sleep_ptr(samurai_usb_prepare),
+	.complete = pm_sleep_ptr(samurai_usb_complete),
+	SYSTEM_SLEEP_PM_OPS(samurai_usb_suspend, samurai_usb_resume)
+};
 
