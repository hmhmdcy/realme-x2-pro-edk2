+/* A fixed sink needs no VBUS source regulator; a DRP/source still does. */
+static int qcom_pmic_typec_port_get_vbus_supply(struct device *dev,
+					     struct pmic_typec_port *port)
+{
+	struct fwnode_handle *connector;
+	const char *power_role;
+	int ret = 0;
+
+	connector = device_get_named_child_node(dev, "connector");
+	if (!connector)
+		return -EINVAL;
+
+	if (!fwnode_property_read_string(connector, "power-role", &power_role))
+		port->sink_only = !strcmp(power_role, "sink");
+
+	port->vdd_vbus = devm_of_regulator_get_optional(dev,
+						     to_of_node(connector), "vbus");
+	if (port->vdd_vbus == ERR_PTR(-ENODEV)) {
+		if (port->sink_only)
+			port->vdd_vbus = devm_regulator_get_optional(dev, "vdd-vbus");
+		else
+			port->vdd_vbus = devm_regulator_get(dev, "vdd-vbus");
+	}
+	if (port->sink_only && port->vdd_vbus == ERR_PTR(-ENODEV))
+		port->vdd_vbus = NULL;
+	else if (IS_ERR(port->vdd_vbus))
+		ret = PTR_ERR(port->vdd_vbus);
+
+	fwnode_handle_put(connector);
+	return ret;
+}
