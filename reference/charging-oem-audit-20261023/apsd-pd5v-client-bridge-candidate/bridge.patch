+  o->pd_phase = OWNER_PD_WAIT_FIRST_OFF;
+  return -EAGAIN;
+ }
+ o->pd_phase = OWNER_PD_SINK_EPOCH;
+ return 0;
+failed:
+ o->pd_error = ret;
+ o->pd_phase = OWNER_PD_FAILED;
+ return ret;
