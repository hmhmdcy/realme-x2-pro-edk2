+   int check = qcom_pmic_typec_5v_status(o->typec, bus_dev, &status);
+   if (!check && !status.error && (ret == -EAGAIN || ret == -EBUSY)) {
+    o->pd_error = ret;
+    o->pd_phase = OWNER_PD_WAIT_FIRST_OFF;
+    return -EAGAIN;
