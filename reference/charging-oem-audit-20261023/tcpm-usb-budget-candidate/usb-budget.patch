+/* The supplier can change its USB allowance without a CC transition
+ * (enumeration, suspend or resume). Only refresh default-Rp, non-PD ready
+ * sinks. Contract negotiation and other states retain TCPM's own limits.
+ */
+static void tcpm_psy_external_power_changed(struct power_supply *psy)
+{
+	struct tcpm_port *port = power_supply_get_drvdata(psy);
+	enum typec_cc_status cc;
+	u32 limit;
+
+	mutex_lock(&port->lock);
+	cc = port->polarity ? port->cc2 : port->cc1;
+	if (port->registered && port->tcpc->get_current_limit &&
+	    port->state == SNK_READY && port->pwr_role == TYPEC_SINK &&
+	    port->attached && port->vbus_present &&
+	    !port->pd_capable && !port->explicit_contract &&
+	    cc == TYPEC_CC_RP_DEF) {
+		limit = tcpm_get_current_limit(port);
+		if (limit != port->current_limit)
+			tcpm_set_current_limit(port, limit, 5000);
+	}
+	mutex_unlock(&port->lock);
+}
