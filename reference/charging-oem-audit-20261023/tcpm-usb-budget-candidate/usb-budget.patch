+/* Default Rp carries no BC1.2/USB enumeration allowance. Read the real
+ * supplier; an unavailable, offline or invalid budget grants no current.
+ * The fixed-5V trial ceiling is a cap, never a substitute for permission.
+ */
+static int qcom_pmic_typec_port_get_current_limit(struct tcpc_dev *tcpc)
+{
+	struct pmic_typec *tcpm = tcpc_to_tcpm(tcpc);
+	struct power_supply *psy = tcpm->pmic_typec_port->usb_psy;
+	union power_supply_propval value;
+	int ret, limit;
+
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_ONLINE, &value);
+	if (ret || value.intval != 1)
+		return 0;
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_CURRENT_MAX, &value);
+	if (ret || value.intval <= 0)
+		return 0;
+	limit = value.intval / 1000;
+	if (tcpm->samurai_fixed_5v)
+		limit = min(limit, 500);
+	return limit;
+}
+
+static int qcom_pmic_typec_port_get_usb_supply(struct device *dev,
+					    struct pmic_typec *tcpm)
+{
+	struct power_supply *psy;
+
+	if (!device_property_present(dev, "power-supplies"))
+		return 0;
+	psy = devm_power_supply_get_by_reference(dev, "power-supplies");
+	if (IS_ERR(psy))
+		return PTR_ERR(psy);
+	if (!psy)
+		return -EPROBE_DEFER;
+	tcpm->pmic_typec_port->usb_psy = psy;
+	tcpm->tcpc.get_current_limit = qcom_pmic_typec_port_get_current_limit;
+	return 0;
+}
