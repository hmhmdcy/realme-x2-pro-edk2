# USB2 DWC3 dual-role and xHCI support for the RMX1931 Type-C host layer.
#
# This is a Kconfig fragment, not a full production config.  Merge it only
# into a separate build tree so the currently deployed gadget-only Image
# remains a rollback artifact.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_GADGET is not set
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_USB_STORAGE=y
