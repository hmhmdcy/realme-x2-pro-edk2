+			phys = <&usb_2_hsphy>, <&usb_2_qmpphy>;
+			phy-names = "usb2-phy", "usb3-phy";
 		};
 
 		videocc: clock-controller@ab00000 {
diff --git a/arch/arm64/boot/dts/qcom/sm8150-samurai.dts b/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
--- a/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
@@ -375,9 +375,18 @@
 
 /* Let DWC3 publish its negotiated gadget current budget to the USB provider. */
 &usb_1_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	qcom,select-utmi-as-pipe-clk;
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
 	usb-psy-name = "samurai-usb-input";
 };
 
+&usb_1_qmpphy {
+	status = "disabled";
+};
+
 /*
  * EUD COM console.  The full EUD block has no usable binding here: the in-tree
  * qcom,eud driver wants a USB role switch and SCM access to enable secure EUD,
