+ * Keeping this overlay OS-only leaves the vendor/compat DTB unchanged.
+ */
+
+&samurai_sensor_power {
+    realme,vdd-min-microvolt = <2856000>;
+    realme,vdd-max-microvolt = <3104000>;
+    realme,vddio-min-microvolt = <1800000>;
