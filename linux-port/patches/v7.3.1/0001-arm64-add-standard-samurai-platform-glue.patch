+static ssize_t status_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct max37 *amp = dev_get_drvdata(dev);
+	unsigned int id, global, enable, raw1, raw2, raw3;
+	int ret;
+	mutex_lock(&amp->lock);
+	if (amp->failed) {
+		ret = -EIO;
+		goto out;
+	}
