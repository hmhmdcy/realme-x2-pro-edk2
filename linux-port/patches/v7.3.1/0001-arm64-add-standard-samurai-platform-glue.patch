diff --git a/Documentation/devicetree/bindings/display/panel/samsung,sofef03f-m.yaml b/Documentation/devicetree/bindings/display/panel/samsung,sofef03f-m.yaml
new file mode 100755
index 000000000..d8debefe1
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/samsung,sofef03f-m.yaml
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,sofef03f-m.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung SOFEF03F_M AMOLED panel
+
+maintainers:
+  - hmhmdcy <hmhmdcy@users.noreply.github.com>
+
+description: |
+  Samsung SOFEF03F_M 1080x2400 AMOLED panel used in the Realme X2 Pro.
+  It uses four DSI lanes in command mode with DSC 1.1, 8 bits per component
+  and 8 bits per pixel. Initial support is limited to the stock 60 Hz mode.
+  The board switches VCI and VDDD with separate GPIO enables.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,sofef03f-m
+  reg:
+    maxItems: 1
+  vddio-supply:
+    description: 1.8 V panel I/O supply
+  vdda-supply:
+    description: 3.0 V analog supply shared with the touch controller
+  reset-gpios:
+    maxItems: 1
+  vci-enable-gpios:
+    maxItems: 1
+    description: Enable the VCI switch, active high
+  vddd-enable-gpios:
+    maxItems: 1
+    description: Enable the VDDD switch, active high
+  port: true
+
+required:
+  - compatible
+  - reg
+  - vddio-supply
+  - vdda-supply
+  - reset-gpios
+  - vci-enable-gpios
+  - vddd-enable-gpios
+  - port
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/power/supply/mps,mp2650.yaml b/Documentation/devicetree/bindings/power/supply/mps,mp2650.yaml
new file mode 100755
index 000000000..204a63d53
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/mps,mp2650.yaml
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/mps,mp2650.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Monolithic Power Systems MP2650 battery charger
+
+maintainers:
+  - Samurai Linux port maintainers <samurai-linux@example.com>
+
+description: |
+  The MP2650 is an I2C battery charger. The Samurai driver currently exposes
+  read-only input voltage, input current, input presence and charging status.
+  Registering the device does not reset or configure the charger. Board charge
+  policy, input power budgets and protection must be handled separately.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: mps,mp2650
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        charger@5c {
+            compatible = "mps,mp2650";
+            reg = <0x5c>;
+        };
+    };
