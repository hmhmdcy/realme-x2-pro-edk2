+	if (IS_ERR(wcd->if_regmap))
+		return dev_err_probe(dev, PTR_ERR(wcd->if_regmap),
+				     "Failed to allocate ifc register map\n");
+
+	ret = devm_add_action_or_reset(dev, wcd934x_regmap_exit_action,
+				       wcd->if_regmap);
+	if (ret)
+		wcd->if_regmap = NULL;
+
+	return ret;
+}
