diff --git a/arch/arm64/boot/dts/qcom/imx319.dtsi b/arch/arm64/boot/dts/qcom/imx319.dtsi
new file mode 100755
index 000000000..516631b2a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/imx319.dtsi
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* RMX1931 camera wiring and voltage constraints from the 19781 board. */
+&cam_pmic_p {
+	/* PLDO inputs are not software-managed here; no dummy VIN is added. */
+	regulators {
+		cam_rear_vdig: ldo1 {
+			regulator-name = "cam-rear-vdig";
+			regulator-min-microvolt = <1100000>;
+			regulator-max-microvolt = <1104000>;
+		};
+		cam_rear_vana: ldo4 {
+			regulator-name = "cam-rear-vana";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+		};
+	};
+};
+
+&tlmm {
+	cam_rear_mclk_active: camera-rear-mclk-active-state {
+		pins = "gpio14";
+		function = "cam_mclk";
+		drive-strength = <6>;
+		bias-disable;
+	};
+	cam_rear_mclk_sleep: camera-rear-mclk-sleep-state {
+		pins = "gpio14";
+		function = "cam_mclk";
+		drive-strength = <6>;
+		bias-pull-down;
+	};
+	cam_rear_reset_active: camera-rear-reset-active-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	cam_rear_reset_sleep: camera-rear-reset-sleep-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		output-low;
+	};
+};
+
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c1 {
+	status = "okay";
+	cam_rear: camera@10 {
+		compatible = "sony,imx319";
+		orientation = <1>;
+		reg = <0x10>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+		vana-supply = <&cam_rear_vana>;
+		vdig-supply = <&cam_rear_vdig>;
+		vif-supply = <&vreg_l1c_1p8>;
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_rear_mclk_active &cam_rear_reset_active>;
+		pinctrl-1 = <&cam_rear_mclk_sleep &cam_rear_reset_sleep>;
+		port {
+			cam_rear_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				/* Four-lane sensor PLL operating point, validated in 237. */
+				link-frequencies = /bits/ 64 <222000000>;
+				remote-endpoint = <&cam_rear_csiphy1_ep>;
+			};
+		};
+	};
+};
+
+&camss {
+	ports {
+		port@1 {
+			reg = <1>;
+			cam_rear_csiphy1_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_rear_ep>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/s5k3m5-samurai.dtsi b/arch/arm64/boot/dts/qcom/s5k3m5-samurai.dtsi
new file mode 100755
index 000000000..bb9a289c4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/s5k3m5-samurai.dtsi
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* RMX1931 telephoto: own board19781 wiring and independently decoded mode3. */
+&cam_pmic_p {
+	regulators {
+		cam_tele_vdig: ldo2 {
+			regulator-name = "cam-tele-vdig";
+			regulator-min-microvolt = <1050000>;
+			regulator-max-microvolt = <1056000>;
+			regulator-enable-ramp-delay = <1000>;
+		};
+		cam_tele_vana: ldo6 {
+			regulator-name = "cam-tele-vana";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-enable-ramp-delay = <1000>;
+		};
+	};
+};
+
+&tlmm {
+	cam_tele_mclk_active: camera-tele-mclk-active-state {
+		pins = "gpio16";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	cam_tele_mclk_sleep: camera-tele-mclk-sleep-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+	cam_tele_reset: camera-tele-reset-state {
+		pins = "gpio23";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+&cci1_i2c0 {
+	status = "okay";
+	cam_tele: camera@2d {
+		compatible = "samsung,s5k3m5";
+		reg = <0x2d>;
+		orientation = <1>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+		vdda-supply = <&cam_tele_vana>;
+		vddd-supply = <&cam_tele_vdig>;
+		vddio-supply = <&vreg_l1c_1p8>;
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_tele_mclk_active &cam_tele_reset>;
+		pinctrl-1 = <&cam_tele_mclk_sleep &cam_tele_reset>;
+		port {
+			cam_tele_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				/* OEM OP-PLL candidate; physical timing is not yet verified. */
+				link-frequencies = /bits/ 64 <723200000>;
+				remote-endpoint = <&cam_tele_csiphy3_ep>;
+			};
+		};
+	};
+};
+
+&camss {
+	ports {
+		port@3 {
+			reg = <3>;
+			cam_tele_csiphy3_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_tele_ep>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/s5kgw1-samurai.dtsi b/arch/arm64/boot/dts/qcom/s5kgw1-samurai.dtsi
new file mode 100755
index 000000000..5b2c4211c
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/s5kgw1-samurai.dtsi
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Board19781 primary sensor: OEM slot0/address0x20 (7-bit 0x10), CSIPHY0. */
+&cam_pmic_q {
+	regulators {
+		cam_main_vdig: ldo1 {
+			regulator-name = "cam-main-vdig";
+			regulator-min-microvolt = <1100000>;
+			regulator-max-microvolt = <1104000>;
+			regulator-enable-ramp-delay = <1000>;
+		};
+		cam_main_vaf: ldo3 {
+			regulator-name = "cam-main-vaf";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-enable-ramp-delay = <1000>;
+		};
+		cam_main_vana: ldo7 {
+			regulator-name = "cam-main-vana";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-enable-ramp-delay = <1000>;
+		};
+	};
+};
+
+&pm8150_gpios {
+	cam_main_reset: camera-main-reset-state {
+		pins = "gpio1";
+		function = "normal";
+		power-source = <0>;
+		bias-disable;
+	};
+};
+
+&tlmm {
+	cam_main_mclk_active: camera-main-mclk-active-state {
+		pins = "gpio13";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+	cam_main_mclk_sleep: camera-main-mclk-sleep-state {
+		pins = "gpio13";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+};
+
+&cci0_i2c0 {
+	status = "okay";
+	cam_main_lens: lens@72 {
+		compatible = "onnn,lc898219xi";
+		reg = <0x72>;
+		vdd-supply = <&cam_main_vaf>;
+	};
+
+	cam_main: camera@10 {
+		compatible = "samsung,s5kgw1";
+		reg = <0x10>;
+		orientation = <1>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+		vdda-supply = <&cam_main_vana>;
+		vddd-supply = <&cam_main_vdig>;
+		vddio-supply = <&vreg_l1c_1p8>;
+		lens-focus = <&cam_main_lens>;
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&pm8150_gpios 1 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_main_mclk_active &cam_main_reset>;
+		pinctrl-1 = <&cam_main_mclk_sleep &cam_main_reset>;
+		port {
+			cam_main_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				/* OP PLL timing candidate; native capture still required. */
+				link-frequencies = /bits/ 64 <499200000>;
+				remote-endpoint = <&cam_main_csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&camss {
+	ports {
+		port@0 {
+			reg = <0>;
+			cam_main_csiphy0_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <0 1 2>;
+				remote-endpoint = <&cam_main_ep>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/samurai-sensor-power-data.dtsi b/arch/arm64/boot/dts/qcom/samurai-sensor-power-data.dtsi
