+	.dapm_widgets = max37_widgets, .num_dapm_widgets = ARRAY_SIZE(max37_widgets),
+	.dapm_routes = max37_routes, .num_dapm_routes = ARRAY_SIZE(max37_routes),
+	.use_pmdown_time = 1, .endianness = 1,
+};
