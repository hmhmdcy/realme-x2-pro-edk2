From: Codex <codex@openai.com>
Date: Mon, 9 Nov 2026 18:20:00 +0800
Subject: [PATCH] drm/panel: sofef03f: resend display-on after first frame

The stock SOFEF03F command sequence sends display-on (0x29) again after
the first frame, in qcom,mdss-dsi-post-on-backlight.  The current driver
sends display-on only from .enable(), before the first-frame gate opens.
On a suspend/resume cycle the panel can therefore reinitialize, report
power mode 0x9c and receive a valid backlight value while the physical
panel remains black.

Send the standard DCS display-on command once after the first-frame gate
opens, before reapplying the standard backlight value.  Keep the sequence
inside the panel driver and use only the existing MIPI DSI helpers.

Signed-off-by: Codex <codex@openai.com>
---
diff --git a/drivers/gpu/drm/panel/panel-samsung-sofef03f.c b/drivers/gpu/drm/panel/panel-samsung-sofef03f.c
--- a/drivers/gpu/drm/panel/panel-samsung-sofef03f.c
+++ b/drivers/gpu/drm/panel/panel-samsung-sofef03f.c
@@ -33,8 +33,9 @@ struct sofef03f {
 	bool supply_enabled[2];
 	bool prefer_90;
 	bool active_90;
 	struct delayed_work backlight_work;
 	unsigned int backlight_retries;
+	bool post_on_sent;
 };
 
 static const struct regulator_bulk_data sofef03f_supplies[] = {
@@ -77,10 +78,27 @@ static void sofef03f_backlight_work(struct work_struct *work)
 	if (!READ_ONCE(ctx->panel.backlight_ready)) {
 		if (ctx->backlight_retries++ < 5)
 			schedule_delayed_work(&ctx->backlight_work,
 					      msecs_to_jiffies(100));
 		return;
 	}
 
+	if (!ctx->post_on_sent) {
+		struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+		mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+		mipi_dsi_msleep(&dsi_ctx, 20);
+		if (dsi_ctx.accum_err) {
+			dev_warn(&ctx->dsi->dev,
+				 "Post-on display-on failed: %d\n",
+				 dsi_ctx.accum_err);
+			if (ctx->backlight_retries++ < 5)
+				schedule_delayed_work(&ctx->backlight_work,
+						      msecs_to_jiffies(100));
+			return;
+		}
+		ctx->post_on_sent = true;
+	}
+
 	backlight_update_status(bl);
 	if (ctx->backlight_retries++ < 1)
 		schedule_delayed_work(&ctx->backlight_work,
@@ -274,6 +292,7 @@ static int sofef03f_enable(struct drm_panel *panel)
 	dev_info(&ctx->dsi->dev, "DSC 1080x2400@%d, power mode 0x%02x (stock 0x9c)\n",
 		 ctx->active_90 ? 90 : 60, power_mode);
 	ctx->backlight_retries = 0;
+	ctx->post_on_sent = false;
 	schedule_delayed_work(&ctx->backlight_work,
 			      msecs_to_jiffies(100));
 	return 0;
@@ -286,6 +305,7 @@ static int sofef03f_disable(struct drm_panel *panel)
 
 	cancel_delayed_work_sync(&ctx->backlight_work);
 	ctx->backlight_retries = 0;
+	ctx->post_on_sent = false;
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 	/* Shutdown must progress to unprepare, including after a DCS timeout. */
 	msleep(22);
