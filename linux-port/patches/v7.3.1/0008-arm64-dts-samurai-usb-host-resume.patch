From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Wed, 11 Nov 2026 00:00:00 +0800
Subject: [PATCH] arm64: dts: qcom: samurai: enable USB host-resume wake policy

Opt the RMX1931 USB2 gadget into the generic keep-connect system-sleep
policy and mark the qcom DWC3 parent as a wakeup source. The existing
dp_hs_phy_irq/dm_hs_phy_irq PDC routing is the hardware wake path; no
board-specific USB driver is added.

This is deliberately a board policy patch, separate from the generic DWC3
and qcom glue changes. It is intended for debug images where the NCM link
must survive system sleep; production power profiles can omit it.

Upstream-Status: Pending

Signed-off-by: Codex <codex@localhost>
---
 arch/arm64/boot/dts/qcom/sm8150-samurai.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-samurai.dts b/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
index ea64f7952..231722a17 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-samurai.dts
@@ -23,12 +23,23 @@ &eud_com {
 	status = "disabled";
 };
 
+/*
+ * Debug policy: keep the NCM gadget attached across system sleep so a host
+ * resume can wake the SoC and the network link can recover without a cable
+ * replug.  The generic DWC3 core rejects system sleep while the USB link is
+ * active; the qcom glue arms the existing DP/DM PDC wake IRQs.
+ */
+&usb_1 {
+	wakeup-source;
+};
+
 &usb_1_dwc3 {
 	status = "okay";
 	dr_mode = "peripheral";
 	maximum-speed = "high-speed";
 	qcom,select-utmi-as-pipe-clk;
 	tx-fifo-resize;
+	snps,gadget-keep-connect-sys-sleep;
 	phys = <&usb_1_hsphy>;
 	phy-names = "usb2-phy";
 };
