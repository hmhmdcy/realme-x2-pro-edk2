From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Wed, 11 Nov 2026 00:00:00 +0800
Subject: [PATCH] usb: dwc3: keep a connected gadget across system sleep

Backport the upstream RFC "snps,gadget-keep-connect-sys-sleep" behaviour.

The default DWC3 gadget system-suspend path soft-disconnects the gadget and
tears the core down, so a host cannot resume the USB link to wake the SoC.
When the new opt-in property is present and the gadget is already connected
with the USB link in U3/L2, keep the controller, PHY and clocks alive and
only mask the gadget IRQ. Resume re-enables the IRQ and drains any pending
event.

System sleep is rejected while the gadget link is active. The platform is
still responsible for arming the hardware wake IRQ that detects the host
resume; this patch deliberately contains no SoC-specific wake code.

This mirrors:
  https://lkml.kernel.org/r/20230320093447.32105-1-rogerq@kernel.org
  https://lkml.kernel.org/r/20230320093447.32105-3-rogerq@kernel.org

Upstream-Status: Pending (RFC, not merged)

Signed-off-by: Codex <codex@localhost>
---
 .../devicetree/bindings/usb/snps,dwc3-common.yaml  |  8 +++++
 drivers/usb/dwc3/core.c                            | 22 +++++++++----
 drivers/usb/dwc3/core.h                            |  8 +++++
 drivers/usb/dwc3/gadget.c                          | 37 +++++++++++++++++++++-
 4 files changed, 67 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/usb/snps,dwc3-common.yaml b/Documentation/devicetree/bindings/usb/snps,dwc3-common.yaml
index 6c0b8b653..a9fe33da8 100644
--- a/Documentation/devicetree/bindings/usb/snps,dwc3-common.yaml
+++ b/Documentation/devicetree/bindings/usb/snps,dwc3-common.yaml
@@ -233,6 +233,14 @@ properties:
       asserts utmi_sleep_n.
     type: boolean
 
+  snps,gadget-keep-connect-sys-sleep:
+    description:
+      Keep a connected gadget attached to the USB host across system sleep
+      when the USB link is already suspended (U3/L2).  The platform must
+      provide a hardware wakeup path for the USB resume event.  System sleep
+      is rejected while the gadget link is active.
+    type: boolean
+
   snps,hird-threshold:
     description: HIRD threshold
     $ref: /schemas/types.yaml#/definitions/uint8
diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
index fd5c2cd36..034b44e1f 100644
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -1874,6 +1874,9 @@ static void dwc3_get_properties(struct dwc3 *dwc)
 	dwc->dis_split_quirk = device_property_read_bool(dev,
 				"snps,dis-split-quirk");
 
+	dwc->gadget_keep_connect_sys_sleep = device_property_read_bool(dev,
+				"snps,gadget-keep-connect-sys-sleep");
+
 	dwc->lpm_nyet_threshold = lpm_nyet_threshold;
 	dwc->tx_de_emphasis = tx_de_emphasis;
 
@@ -2566,7 +2569,8 @@ static int dwc3_suspend_common(struct dwc3 *dwc, pm_message_t msg)
 		if (ret)
 			return ret;
 		synchronize_irq(dwc->irq_gadget);
-		dwc3_core_exit(dwc);
+		if (!dwc3_gadget_keep_connect(dwc))
+			dwc3_core_exit(dwc);
 		break;
 	case DWC3_GCTL_PRTCAP_HOST:
 		if (!PMSG_IS_AUTO(msg) &&
@@ -2625,11 +2629,13 @@ static int dwc3_resume_common(struct dwc3 *dwc, pm_message_t msg)
 
 	switch (dwc->current_dr_role) {
 	case DWC3_GCTL_PRTCAP_DEVICE:
-		ret = dwc3_core_init_for_resume(dwc);
-		if (ret)
-			return ret;
+		if (!dwc3_gadget_keep_connect(dwc)) {
+			ret = dwc3_core_init_for_resume(dwc);
+			if (ret)
+				return ret;
 
-		dwc3_set_prtcap(dwc, DWC3_GCTL_PRTCAP_DEVICE, true);
+			dwc3_set_prtcap(dwc, DWC3_GCTL_PRTCAP_DEVICE, true);
+		}
 		dwc3_gadget_resume(dwc);
 		break;
 	case DWC3_GCTL_PRTCAP_HOST:
@@ -2797,7 +2803,8 @@ int dwc3_pm_suspend(struct dwc3 *dwc)
 	if (ret)
 		return ret;
 
-	pinctrl_pm_select_sleep_state(dev);
+	if (!dwc3_gadget_keep_connect(dwc))
+		pinctrl_pm_select_sleep_state(dev);
 
 	return 0;
 }
@@ -2808,7 +2815,8 @@ int dwc3_pm_resume(struct dwc3 *dwc)
 	struct device *dev = dwc->dev;
 	int		ret = 0;
 
-	pinctrl_pm_select_default_state(dev);
+	if (!dwc3_gadget_keep_connect(dwc))
+		pinctrl_pm_select_default_state(dev);
 
 	pm_runtime_disable(dev);
 	ret = pm_runtime_set_active(dev);
diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index f3dabb37f..7cabf7ac6 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1403,6 +1403,7 @@ struct dwc3 {
 	unsigned		usb2_lpm_disable:1;
 	unsigned		usb2_gadget_lpm_disable:1;
 	unsigned		needs_full_reinit:1;
+	unsigned		gadget_keep_connect_sys_sleep:1;
 
 	unsigned		disable_scramble_quirk:1;
 	unsigned		u2exit_lfps_quirk:1;
@@ -1684,6 +1685,13 @@ static inline void dwc3_host_exit(struct dwc3 *dwc)
 { }
 #endif
 
+static inline bool dwc3_gadget_keep_connect(struct dwc3 *dwc)
+{
+	return dwc->gadget_keep_connect_sys_sleep &&
+	       dwc->current_dr_role == DWC3_GCTL_PRTCAP_DEVICE &&
+	       dwc->connected;
+}
+
 #if IS_ENABLED(CONFIG_USB_DWC3_GADGET) || IS_ENABLED(CONFIG_USB_DWC3_DUAL_ROLE)
 int dwc3_gadget_init(struct dwc3 *dwc);
 void dwc3_gadget_exit(struct dwc3 *dwc);
diff --git a/drivers/usb/dwc3/gadget.c b/drivers/usb/dwc3/gadget.c
index ee8372356..4e7ee8336 100644
--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -4994,6 +4994,22 @@ int dwc3_gadget_suspend(struct dwc3 *dwc)
 {
 	int ret;
 
+	if (dwc3_gadget_keep_connect(dwc)) {
+		int link_state = dwc3_gadget_get_link_state(dwc);
+
+		/*
+		 * We cannot service USB transactions while the system is
+		 * asleep.  Only keep the gadget connected if the host has
+		 * already suspended the bus, so resume is the only event
+		 * that can arrive.
+		 */
+		if (link_state != DWC3_LINK_STATE_U3)
+			return -EBUSY;
+
+		dwc3_gadget_disable_irq(dwc);
+		return 0;
+	}
+
 	ret = dwc3_gadget_soft_disconnect(dwc);
 	/*
 	 * Attempt to reset the controller's state. Likely no
@@ -5012,7 +5028,26 @@ int dwc3_gadget_suspend(struct dwc3 *dwc)
 
 int dwc3_gadget_resume(struct dwc3 *dwc)
 {
-	if (!dwc->gadget_driver || !dwc->softconnect)
+	irqreturn_t irq;
+
+	if (!dwc->gadget_driver)
+		return 0;
+
+	if (dwc3_gadget_keep_connect(dwc)) {
+		dwc3_gadget_enable_irq(dwc);
+
+		/*
+		 * The resume event may already be pending.  Drain it now
+		 * instead of waiting for the next interrupt.
+		 */
+		irq = dwc3_check_event_buf(dwc->ev_buf);
+		if (irq == IRQ_WAKE_THREAD)
+			dwc3_process_event_buf(dwc->ev_buf);
+
+		return 0;
+	}
+
+	if (!dwc->softconnect)
 		return 0;
 
 	return dwc3_gadget_soft_connect(dwc);
