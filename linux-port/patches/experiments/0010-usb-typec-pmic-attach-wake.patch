From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Wed, 11 Nov 2026 22:15:00 +0800
Subject: [PATCH] usb: typec: qcom-pmic: arm attach/VBUS IRQs as wake sources

The Qualcomm PMIC Type-C port driver requests its SPMI child interrupts
with IRQF_NO_AUTOEN and enables them only while the Type-C port is active.
None of those interrupts is armed as a system wakeup source, so a charger
or USB cable cannot wake the SoC through PM8150B even when the SPMI
periph_irq parent is routed through the Qualcomm PDC.

Allow a Type-C node to opt in with the standard wakeup-source property.
While suspended, arm the CC-state, VBUS-change, and attach-detach IRQs with
enable_irq_wake(); the SPMI PMIC arbiter propagates the wake request to its
PDC parent. Disarm them on resume.

Upstream-Status: Pending

Signed-off-by: Codex <codex@localhost>
---
diff --git a/Documentation/devicetree/bindings/usb/qcom,pmic-typec.yaml b/Documentation/devicetree/bindings/usb/qcom,pmic-typec.yaml
index ba790c448..a01cade4e 100644
--- a/Documentation/devicetree/bindings/usb/qcom,pmic-typec.yaml
+++ b/Documentation/devicetree/bindings/usb/qcom,pmic-typec.yaml
@@ -85,6 +85,10 @@ properties:
   vdd-pdphy-supply:
     description: VDD regulator supply to the PDPHY.
 
+  wakeup-source:
+    type: boolean
+    description: Enable Type-C attach and VBUS interrupts as system wakeup sources.
+
 required:
   - compatible
   - reg
diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
index d770e58bc..4d7149feb 100644
--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
+++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec.c
@@ -134,6 +134,23 @@ static void qcom_pmic_typec_remove(struct platform_device *pdev)
 	fwnode_handle_put(tcpm->tcpc.fwnode);
 }
 
+static int qcom_pmic_typec_suspend(struct device *dev)
+{
+	struct pmic_typec *tcpm = dev_get_drvdata(dev);
+
+	return qcom_pmic_typec_port_suspend(tcpm);
+}
+
+static int qcom_pmic_typec_resume(struct device *dev)
+{
+	struct pmic_typec *tcpm = dev_get_drvdata(dev);
+
+	return qcom_pmic_typec_port_resume(tcpm);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(qcom_pmic_typec_pm_ops,
+				qcom_pmic_typec_suspend, qcom_pmic_typec_resume);
+
 static const struct pmic_typec_resources pm8150b_typec_res = {
 	.pdphy_res = &pm8150b_pdphy_res,
 	.port_res = &pm8150b_port_res,
@@ -155,6 +172,7 @@ static struct platform_driver qcom_pmic_typec_driver = {
 	.driver = {
 		.name = "qcom,pmic-typec",
 		.of_match_table = qcom_pmic_typec_table,
+		.pm = pm_sleep_ptr(&qcom_pmic_typec_pm_ops),
 	},
 	.probe = qcom_pmic_typec_probe,
 	.remove = qcom_pmic_typec_remove,
diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
index d3523435f..949868f57 100644
--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
+++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.c
@@ -179,6 +179,7 @@ struct pmic_typec_port {
 	int				cc;
 	bool				debouncing_cc;
 	struct delayed_work		cc_debounce_dwork;
+	bool				wake_armed;
 
 	spinlock_t			lock;	/* Register atomicity */
 };
@@ -689,6 +690,85 @@ static int qcom_pmic_typec_port_start(struct pmic_typec *tcpm,
 	return ret;
 }
 
+static bool
+qcom_pmic_typec_port_is_wake_irq(const struct pmic_typec_port_irq_data *irq_data)
+{
+	switch (irq_data->virq) {
+	case PMIC_TYPEC_CC_STATE_IRQ:
+	case PMIC_TYPEC_VBUS_IRQ:
+	case PMIC_TYPEC_ATTACH_DETACH_IRQ:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int qcom_pmic_typec_port_set_wake(struct pmic_typec *tcpm, bool enable)
+{
+	struct pmic_typec_port *pmic_typec_port = tcpm->pmic_typec_port;
+	struct device *dev = pmic_typec_port->dev;
+	unsigned long armed = 0;
+	int ret = 0;
+	int i;
+
+	if (!enable && !pmic_typec_port->wake_armed)
+		return 0;
+
+	if (enable && !device_may_wakeup(dev))
+		return 0;
+
+	if (pmic_typec_port->wake_armed == enable)
+		return 0;
+
+	for (i = 0; i < pmic_typec_port->nr_irqs; i++) {
+		struct pmic_typec_port_irq_data *irq_data =
+			&pmic_typec_port->irq_data[i];
+
+		if (!qcom_pmic_typec_port_is_wake_irq(irq_data))
+			continue;
+
+		if (enable)
+			ret = enable_irq_wake(irq_data->irq);
+		else
+			ret = disable_irq_wake(irq_data->irq);
+		if (ret) {
+			dev_err(dev, "failed to %s wake IRQ %d: %d\n",
+				enable ? "enable" : "disable",
+				irq_data->irq, ret);
+			goto unwind;
+		}
+		armed |= BIT(i);
+	}
+
+	pmic_typec_port->wake_armed = enable;
+	return 0;
+
+unwind:
+	for (i = pmic_typec_port->nr_irqs - 1; i >= 0; i--) {
+		struct pmic_typec_port_irq_data *irq_data =
+			&pmic_typec_port->irq_data[i];
+
+		if (!(armed & BIT(i)))
+			continue;
+
+		if (enable)
+			disable_irq_wake(irq_data->irq);
+		else
+			enable_irq_wake(irq_data->irq);
+	}
+	return ret;
+}
+
+int qcom_pmic_typec_port_suspend(struct pmic_typec *tcpm)
+{
+	return qcom_pmic_typec_port_set_wake(tcpm, true);
+}
+
+int qcom_pmic_typec_port_resume(struct pmic_typec *tcpm)
+{
+	return qcom_pmic_typec_port_set_wake(tcpm, false);
+}
+
 static void qcom_pmic_typec_port_stop(struct pmic_typec *tcpm)
 {
 	struct pmic_typec_port *pmic_typec_port = tcpm->pmic_typec_port;
@@ -770,6 +850,12 @@ int qcom_pmic_typec_port_probe(struct platform_device *pdev,
 
 	tcpm->pmic_typec_port = pmic_typec_port;
 
+	if (device_property_read_bool(dev, "wakeup-source")) {
+		ret = devm_device_init_wakeup(dev);
+		if (ret)
+			return ret;
+	}
+
 	tcpm->tcpc.get_vbus = qcom_pmic_typec_port_get_vbus;
 	tcpm->tcpc.set_vbus = qcom_pmic_typec_port_set_vbus;
 	tcpm->tcpc.set_cc = qcom_pmic_typec_port_set_cc;
diff --git a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.h b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.h
index 2ca83a46c..dba112c3a 100644
--- a/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.h
+++ b/drivers/usb/typec/tcpm/qcom/qcom_pmic_typec_port.h
@@ -31,5 +31,7 @@ int qcom_pmic_typec_port_probe(struct platform_device *pdev,
 			       const struct pmic_typec_port_resources *res,
 			       struct regmap *regmap,
 			       u32 base);
+int qcom_pmic_typec_port_suspend(struct pmic_typec *tcpm);
+int qcom_pmic_typec_port_resume(struct pmic_typec *tcpm);
 
 #endif /* __QCOM_PMIC_TYPE_C_PORT_H__ */
