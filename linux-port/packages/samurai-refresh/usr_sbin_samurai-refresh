#!/bin/sh
# Select a stock panel mode through the active Wayland compositor.
set -eu
umask 077
LC_ALL=C
export LC_ALL
output=${SAMURAI_DISPLAY_OUTPUT:-DSI-1}

tr '\0' '\n' < /proc/device-tree/compatible | grep -qx realme,samurai

find_wayland()
{
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ] &&
       [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
        return
    fi
    for socket in /run/user/*/wayland-*; do
        [ -S "$socket" ] || continue
        owner=$(stat -c '%u' "$socket")
        if [ "$(id -u)" -ne 0 ] && [ "$owner" -ne "$(id -u)" ]; then
            continue
        fi
        XDG_RUNTIME_DIR=${socket%/*}
        WAYLAND_DISPLAY=${socket##*/}
        export XDG_RUNTIME_DIR WAYLAND_DISPLAY
        return
    done
    echo 'No accessible Wayland compositor socket found' >&2
    exit 1
}

find_mode()
{
    wlr-randr --output "$output" | awk -v want="$1" '
        $1 ~ /^[0-9]+x[0-9]+$/ && $2 == "px," && $4 == "Hz" {
            split($3, refresh, ".");
            if (refresh[1] + 0 == want) {
                print $1 "@" $3;
                exit
            }
        }
    '
}

status()
{
    wlr-randr --output "$output"
}

usage()
{
    echo "Use: $0 status|60|90" >&2
    exit 2
}

find_wayland
case "${1:-}" in
    status)
        status
        ;;
    60|90)
        mode=$(find_mode "$1")
        if [ -z "$mode" ]; then
            echo "No ${1} Hz mode reported for $output" >&2
            status >&2
            exit 1
        fi
        wlr-randr --dryrun --output "$output" --on --mode "$mode"
        wlr-randr --output "$output" --on --mode "$mode"
        printf 'Selected %s on %s\n' "$mode" "$output"
        status
        ;;
    *)
        usage
        ;;
esac
