options="!check"
install="$pkgname.post-install"
depends="python3 samurai-hexagonrpcd samurai-libssc libssc iio-sensor-proxy
	coreutils kmod"
source="
	samurai-ssc.py
	samurai-ssc.initd
	samurai-ssc.post-install
	"

package() {
	install -Dm755 "$srcdir"/samurai-ssc.py "$pkgdir"/usr/sbin/samurai-ssc
	install -Dm755 "$srcdir"/samurai-ssc.initd \
		"$pkgdir"/etc/init.d/samurai-ssc
}

