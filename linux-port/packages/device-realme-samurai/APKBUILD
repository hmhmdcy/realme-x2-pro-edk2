maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=device-realme-samurai
pkgver=2
pkgrel=1
pkgdesc="Realme X2 Pro userspace for the external EDK2/native Linux boot chain"
url="https://github.com/hmhmdcy/realme-x2-pro-pmaports"
arch="aarch64"
license="MIT"
depends="device-realme-samurai-kernel-none postmarketos-base samurai-systemd
	samurai-platform samurai-radio-tools samurai-desktop samurai-camera-stack
	samurai-gnss-assist samurai-ssc"
source="
	machine-info
	device-realme-samurai
	external-kernel.txt
	"

subpackages="$pkgname-kernel-none"

package() {
	install -Dm644 "$srcdir"/machine-info "$pkgdir"/etc/machine-info
	install -Dm644 "$srcdir"/device-realme-samurai \
		"$pkgdir"/usr/share/deviceinfo/device-realme-samurai
	ln -sf device-realme-samurai "$pkgdir"/usr/share/deviceinfo/deviceinfo
}

# The EDK2 boot chain supplies its own kernel and modules, so this device
# must not depend on a linux-* flavour.  The marker below is also what the
# packaged mkinitfs trigger checks before skipping kernel-image actions.
kernel_none() {
	pkgdesc="External EDK2/kernel boot chain (no kernel installed by apk)"
	install -Dm644 "$srcdir"/external-kernel.txt \
		"$subpkgdir"/usr/share/samurai/external-kernel.txt
}

