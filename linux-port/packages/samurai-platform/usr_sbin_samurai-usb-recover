#!/bin/sh
# Bounded recovery for a DWC3 controller that loses an established NCM link.
set -eu

root=${SAMURAI_USB_RECOVER_ROOT:-}
udc_dir=${SAMURAI_UDC_DIR:-$root/sys/class/udc}
configfs_dir=${SAMURAI_CONFIGFS_DIR:-$root/sys/kernel/config/usb_gadget}
online_path=$root/sys/class/power_supply/mp2650-input/online
carrier_path=$root/sys/class/net/usb0/carrier
unbind_path=$root/sys/bus/platform/drivers/dwc3-qcom/unbind
bind_path=$root/sys/bus/platform/drivers/dwc3-qcom/bind
run_dir=${SAMURAI_USB_RECOVER_RUN_DIR:-$root/run/samurai-usb-recover}
log_file=${SAMURAI_USB_RECOVER_LOG:-$root/var/log/samurai/usb-recover.log}
dbus_enabled=${SAMURAI_USB_RECOVER_DBUS:-1}
interval=${SAMURAI_USB_RECOVER_INTERVAL:-2}
grace=${SAMURAI_USB_RECOVER_GRACE:-12}
reattach_grace=${SAMURAI_USB_RECOVER_REATTACH_GRACE:-20}
mode_grace=${SAMURAI_USB_RECOVER_MODE_GRACE:-10}
max_attempts=${SAMURAI_USB_RECOVER_MAX:-2}
stable_reset=${SAMURAI_USB_RECOVER_STABLE_RESET:-300}

discover_udc()
{
	if [ -n "${SAMURAI_UDC:-}" ]; then
		udc=$SAMURAI_UDC
		[ -e "$udc_dir/$udc" ] ||
			{ echo "[usb-recover] selected UDC unavailable: $udc" >&2; exit 1; }
		return
	fi
	if [ -e "$udc_dir/a600000.usb" ]; then
		udc=a600000.usb
		return
	fi
	selected=
	for candidate in "$udc_dir"/*; do
		[ -e "$candidate" ] || continue
		[ -z "$selected" ] ||
			{ echo "[usb-recover] multiple UDCs; set SAMURAI_UDC" >&2; exit 1; }
		selected=${candidate##*/}
	done
	[ -n "$selected" ] ||
		{ echo "[usb-recover] no UDC found in $udc_dir" >&2; exit 1; }
	udc=$selected
}

read_value()
{
	cat "$1" 2>/dev/null | tr -d '[:space:]' || true
}

log_event()
{
	mkdir -p "${log_file%/*}"
	printf '%s %s\n' "$(date -Is)" "$*" >>"$log_file"
}

write_state()
{
	printf '%s\n' "$2" >"$run_dir/$1"
}

read_state()
{
	read_value "$run_dir/$1"
}

dbus_usb_mode()
{
	[ "$dbus_enabled" = 1 ] || return 1
	command -v dbus-send >/dev/null 2>&1 || return 1
	reply=$(dbus-send --system --type=method_call --print-reply \
		--reply-timeout=5000 \
		--dest=com.meego.usb_moded /com/meego/usb_moded \
		com.meego.usb_moded.mode_request 2>/dev/null) || return 1
	mode=$(printf '%s\n' "$reply" |
		sed -n 's/.*string "\(.*\)"/\1/p' | tail -n 1)
	[ -n "$mode" ] || return 1
	printf '%s\n' "$mode"
}

monitor_usb_mode()
{
	if [ "$dbus_enabled" = 1 ]; then
		dbus_usb_mode
	else
		configfs_usb_mode
	fi
}

configfs_usb_mode()
{
	for gadget in "$configfs_dir"/*; do
		[ -d "$gadget" ] || continue
		case ${gadget##*/} in
		usb-signaller-developer)
			printf '%s\n' developer_mode
			return 0
			;;
		usb-signaller-tethering)
			printf '%s\n' tethering_mode
			return 0
			;;
		usb-signaller-mtp)
			printf '%s\n' mtp_ffs_mode
			return 0
			;;
		esac
	done
	return 1
}

ncm_gadget_generation()
{
	case $1 in
	developer_mode)
		gadget=$configfs_dir/usb-signaller-developer
		;;
	tethering_mode)
		gadget=$configfs_dir/usb-signaller-tethering
		;;
	*)
		return 1
		;;
	esac
	[ -d "$gadget" ] || return 1
	# A standard usb-signaller mode change tears down and recreates the
	# configfs gadget.  Track that identity as well as the D-Bus mode name
	# so a short host_mode transition cannot be missed by the poll loop.
	stat -c '%i:%Y:%Z' "$gadget" 2>/dev/null || return 1
}

refresh_generation_baseline()
{
	mode=$(configfs_usb_mode 2>/dev/null || true)
	[ -n "$mode" ] || return 0
	generation=$(ncm_gadget_generation "$mode" 2>/dev/null || true)
	[ -n "$generation" ] && write_state generation "$generation"
}

current_usb_mode()
{
	mode=$(dbus_usb_mode 2>/dev/null || true)
	if [ -n "$mode" ]; then
		printf '%s\n' "$mode"
		return 0
	fi
	mode=$(configfs_usb_mode 2>/dev/null || true)
	if [ -n "$mode" ]; then
		printf '%s\n' "$mode"
		return 0
	fi
	printf '%s\n' charging_only
}

wait_usb_dbus()
{
	limit=${1:-30}
	count=0
	[ "$dbus_enabled" = 1 ] || return 1
	command -v dbus-send >/dev/null 2>&1 || return 1
	while [ "$count" -lt "$limit" ]; do
		if dbus-send --system --type=method_call --print-reply \
			--dest=com.meego.usb_moded /com/meego/usb_moded \
			com.meego.usb_moded.get_modes >/dev/null 2>&1; then
			return 0
		fi
		count=$((count + 1))
		sleep 1
	done
	return 1
}

request_usb_mode()
{
	wanted=$1
	[ "$dbus_enabled" = 1 ] || return 1
	command -v dbus-send >/dev/null 2>&1 || return 1
	dbus-send --system --type=method_call --print-reply \
		--dest=com.meego.usb_moded /com/meego/usb_moded \
		com.meego.usb_moded.set_mode "string:$wanted" >/dev/null 2>&1
}

wait_usb_mode()
{
	wanted=$1
	limit=${2:-30}
	count=0
	while [ "$count" -lt "$limit" ]; do
		if [ "$(dbus_usb_mode 2>/dev/null || true)" = "$wanted" ]; then
			return 0
		fi
		count=$((count + 1))
		sleep 1
	done
	return 1
}

wait_udc_state()
{
	wanted=$1
	limit=$2
	count=0
	while [ "$count" -lt "$limit" ]; do
		state=$(read_value "$udc_dir/$udc/state")
		if [ "$state" = "$wanted" ]; then
			return 0
		fi
		count=$((count + 1))
		sleep 1
	done
	return 1
}

reconnect_udc()
{
	soft_connect=$udc_dir/$udc/soft_connect
	[ -w "$soft_connect" ] || return 0
	printf 'disconnect\n' >"$soft_connect" || return 1
	sleep 1
	printf 'connect\n' >"$soft_connect" || return 1
}

service_bounded()
{
	if command -v timeout >/dev/null 2>&1; then
		timeout 30 rc-service "$@" >/dev/null 2>&1
	else
		rc-service "$@" >/dev/null 2>&1
	fi
}

restart_gadget()
{
	# usb-signaller is the standard owner of configfs, UDC binding and the
	# usb-moded D-Bus API. Preserve the active mode across a forced DWC3
	# rebind; restarting usb-signaller alone would otherwise fall back to its
	# configured default (developer) mode.
	requested_mode=$(current_usb_mode 2>/dev/null || true)
	case $requested_mode in
	developer_mode|tethering_mode|mtp_ffs_mode|charging_only) ;;
	*) requested_mode= ;;
	esac

	if [ -n "${SAMURAI_USB_RECOVER_RESTART_CMD:-}" ]; then
		sh -c "$SAMURAI_USB_RECOVER_RESTART_CMD"
	elif command -v rc-service >/dev/null 2>&1 &&
		[ -x /etc/init.d/usb-signaller ]; then
		service_bounded usb-signaller stop || true
		service_bounded usb-signaller start || true
		wait_usb_dbus 30 || true
		if [ -n "$requested_mode" ]; then
			request_usb_mode "$requested_mode" || true
			wait_usb_mode "$requested_mode" 30 || true
		fi
		# If usb-signaller could not apply the preserved mode, start the
		# matching standard mode service as a bounded fallback.
		actual_mode=$(dbus_usb_mode 2>/dev/null || true)
		if [ -n "$requested_mode" ] &&
			[ "$actual_mode" != "$requested_mode" ]; then
			case $requested_mode in
			developer_mode)
				service_bounded usb-signaller-developer-mode start || true
				;;
			tethering_mode)
				service_bounded usb-signaller-tethering-mode start || true
				;;
			mtp_ffs_mode)
				service_bounded usb-signaller-mtp-mode start || true
				;;
			esac
		fi
		# usb-signaller may have started the mode service before the host
		# created usb0. Restart the standard userspace mode after the D-Bus
		# mode is established so NetworkManager and FunctionFS are rebound.
		if [ -n "$requested_mode" ]; then
			case $requested_mode in
			developer_mode)
				service_bounded usb-signaller-developer-mode restart ||
					service_bounded usb-signaller-developer-mode start ||
					true
				;;
			tethering_mode)
				service_bounded usb-signaller-tethering-mode restart ||
					service_bounded usb-signaller-tethering-mode start ||
					true
				;;
			mtp_ffs_mode)
				service_bounded usb-signaller-mtp-mode restart ||
					service_bounded usb-signaller-mtp-mode start ||
					true
				;;
			esac
		fi
	elif command -v rc-service >/dev/null 2>&1; then
		service_bounded samurai-usb restart || true
	else
		/usr/sbin/samurai-usb start
	fi
}

recover_link()
{
	reason=${1:-link_lost}
	attempts=$(read_state attempts)
	case $attempts in
	''|*[!0-9]*) attempts=0 ;;
	esac
	if [ "$attempts" -ge "$max_attempts" ]; then
		log_event "GIVE_UP attempts=$attempts reason=$reason state=$(read_value "$udc_dir/$udc/state") carrier=$(read_value "$carrier_path")"
		write_state armed 0
		return 1
	fi
	attempts=$((attempts + 1))
	write_state attempts "$attempts"
	log_event "RECOVER_BEGIN attempt=$attempts reason=$reason state=$(read_value "$udc_dir/$udc/state") carrier=$(read_value "$carrier_path")"

	if [ -w "$unbind_path" ]; then
		printf '%s\n' "$udc" >"$unbind_path" || true
	fi
	count=0
	while [ -e "$udc_dir/$udc/state" ] && [ "$count" -lt 10 ]; do
		count=$((count + 1))
		sleep 1
	done

	if [ -w "$bind_path" ]; then
		printf '%s\n' "$udc" >"$bind_path" || true
	fi
	count=0
	while [ ! -e "$udc_dir/$udc/state" ] && [ "$count" -lt 20 ]; do
		count=$((count + 1))
		sleep 1
	done
	[ -e "$udc_dir/$udc/state" ] ||
		{ log_event "RECOVER_FAIL reason=udc_missing"; return 1; }

	restart_gadget >/dev/null 2>&1 || true
	# restart_gadget intentionally recreates the active configfs gadget.
	# Record that generation as the new baseline so the monitor does not
	# mistake our own recovery for a fresh user mode transition and reset
	# the retry budget forever.
	refresh_generation_baseline
	# A DWC3 rebind can leave the host with stale DHCP/NCM state.  Toggle
	# the standard UDC soft_connect control after userspace is ready so
	# the host performs a clean enumeration and DHCP exchange.
	reconnect_udc || true
	if ! wait_udc_state configured 30; then
		log_event "RECOVER_FAIL reason=not_configured state=$(read_value "$udc_dir/$udc/state")"
		return 1
	fi
	count=0
	while [ "$(read_value "$carrier_path")" != 1 ] && [ "$count" -lt 10 ]; do
		count=$((count + 1))
		sleep 1
	done
	if [ "$(read_value "$carrier_path")" != 1 ]; then
		log_event "RECOVER_FAIL reason=no_carrier state=configured"
		return 1
	fi

	write_state armed 1
	write_state stable_since "$(date +%s)"
	write_state reattach_since 0
	write_state mode_reattach_since 0
	refresh_generation_baseline
	log_event "RECOVER_OK attempt=$attempts reason=$reason state=configured carrier=1"
	return 0
}

status()
{
	printf 'udc=%s\n' "$udc"
	printf 'state=%s\n' "$(read_value "$udc_dir/$udc/state")"
	printf 'carrier=%s\n' "$(read_value "$carrier_path")"
	printf 'online=%s\n' "$(read_value "$online_path")"
	printf 'armed=%s\n' "$(read_state armed)"
	printf 'attempts=%s\n' "$(read_state attempts)"
	printf 'reattach_since=%s\n' "$(read_state reattach_since)"
	printf 'mode_reattach_since=%s\n' "$(read_state mode_reattach_since)"
	printf 'seen_configured=%s\n' "$(read_state seen_configured)"
}

monitor()
{
	mkdir -p "$run_dir"
	[ -e "$run_dir/attempts" ] || write_state attempts 0
	[ -e "$run_dir/armed" ] || write_state armed 0
	[ -e "$run_dir/online" ] || write_state online 0
	[ -e "$run_dir/stable_since" ] || write_state stable_since 0
	[ -e "$run_dir/reattach_since" ] || write_state reattach_since 0
	[ -e "$run_dir/mode_reattach_since" ] || write_state mode_reattach_since 0
	[ -e "$run_dir/seen_configured" ] || write_state seen_configured 0
	stuck_since=0
	previous_ncm_mode=0

	while :; do
		previous_generation=$(read_state generation)
		mode=$(monitor_usb_mode 2>/dev/null || true)
		if [ -z "$mode" ]; then
			if [ "$previous_ncm_mode" != unknown ]; then
				log_event "MODE_UNKNOWN; recovery paused"
			fi
			previous_ncm_mode=unknown
			stuck_since=0
			sleep "$interval"
			continue
		fi
		case $mode in
		developer_mode|tethering_mode) ncm_mode=1 ;;
		*) ncm_mode=0 ;;
		esac
		generation=
		if [ "$ncm_mode" = 1 ]; then
			generation=$(ncm_gadget_generation "$mode" 2>/dev/null || true)
			# During a role transition usb-moded can report the requested
			# NCM mode while the host-mode gadget is already active.  The
			# configfs gadget is the authoritative userspace session marker.
			[ -n "$generation" ] || ncm_mode=0
		fi
		if [ "$ncm_mode" = 1 ]; then
			if [ "$previous_ncm_mode" = 1 ] &&
				[ -n "$previous_generation" ] &&
				[ "$generation" = "$previous_generation" ]; then
				mode_transition=0
			else
				mode_transition=1
				attempts=$(read_state attempts)
				case $attempts in
				''|*[!0-9]*) attempts=0 ;;
				esac
				if [ "$attempts" -gt 0 ]; then
					write_state attempts 0
					log_event "BUDGET_RESET reason=mode_transition attempts=$attempts"
				fi
				write_state generation "$generation"
			fi
			previous_ncm_mode=1
		else
			mode_transition=0
			previous_ncm_mode=0
		fi
		if [ "$ncm_mode" -ne 1 ]; then
			if [ "$(read_state armed)" = 1 ]; then
				log_event "DISARM reason=mode=$mode"
			fi
			write_state armed 0
			write_state stable_since 0
			write_state reattach_since 0
			write_state mode_reattach_since 0
			stuck_since=0
			sleep "$interval"
			continue
		fi

		online=$(read_value "$online_path")
		previous_online=$(read_state online)
		if [ "$online" = 1 ] && [ "$previous_online" != 1 ]; then
			write_state attempts 0
			write_state armed 0
			if [ "$(read_state seen_configured)" = 1 ]; then
				write_state reattach_since "$(date +%s)"
			else
				write_state reattach_since 0
			fi
			log_event "VBUS_ON seen=$(read_state seen_configured) state=$(read_value "$udc_dir/$udc/state") carrier=$(read_value "$carrier_path")"
		elif [ "$online" != 1 ] && [ "$previous_online" = 1 ]; then
			write_state reattach_since 0
			log_event "VBUS_OFF state=$(read_value "$udc_dir/$udc/state") carrier=$(read_value "$carrier_path")"
		fi
		write_state online "$online"

		if [ "$online" != 1 ]; then
			if [ "$(read_state armed)" = 1 ]; then
				log_event "DISARM reason=no_vbus"
			fi
			write_state armed 0
			write_state stable_since 0
			write_state reattach_since 0
			stuck_since=0
			sleep "$interval"
			continue
		fi

		state=$(read_value "$udc_dir/$udc/state")
		carrier=$(read_value "$carrier_path")
		if [ "$state" = configured ] && [ "$carrier" = 1 ]; then
			now=$(date +%s)
			stable_since=$(read_state stable_since)
			case $stable_since in
			''|*[!0-9]*|0) stable_since=$now ;;
			esac
			write_state stable_since "$stable_since"
			write_state reattach_since 0
			write_state mode_reattach_since 0
			write_state seen_configured 1
			if [ "$(read_state armed)" != 1 ]; then
				log_event "ARM state=configured carrier=1"
			fi
			write_state armed 1
			stuck_since=0
			attempts=$(read_state attempts)
			case $attempts in
			''|*[!0-9]*) attempts=0 ;;
			esac
			if [ "$attempts" -gt 0 ] &&
				[ $((now - stable_since)) -ge "$stable_reset" ]; then
				write_state attempts 0
				write_state stable_since "$now"
				log_event "ATTEMPTS_RESET stable_seconds=$stable_reset"
			fi
		elif [ "$(read_state armed)" = 1 ]; then
			now=$(date +%s)
			write_state stable_since 0
			if [ "$stuck_since" -eq 0 ]; then
				stuck_since=$now
				log_event "LINK_LOST state=$state carrier=$carrier"
			elif [ $((now - stuck_since)) -ge "$grace" ]; then
				if recover_link link_lost; then
					stuck_since=0
				else
					stuck_since=$now
					if [ "$(read_state attempts)" -ge "$max_attempts" ]; then
						write_state armed 0
					fi
				fi
			fi
		else
			reattach_since=$(read_state reattach_since)
			case $reattach_since in
			''|*[!0-9]*|0) reattach_since=0 ;;
			esac
			now=$(date +%s)
			if [ "$reattach_since" -gt 0 ] &&
				[ $((now - reattach_since)) -ge "$reattach_grace" ]; then
				if recover_link reattach; then
					write_state reattach_since 0
				else
					reattach_since=$(date +%s)
					if [ "$(read_state attempts)" -ge "$max_attempts" ]; then
						write_state reattach_since 0
					fi
				fi
			fi
			mode_reattach_since=$(read_state mode_reattach_since)
			case $mode_reattach_since in
			''|*[!0-9]*|0) mode_reattach_since=0 ;;
			esac
			if [ "$mode_transition" = 1 ] &&
				[ "$(read_state seen_configured)" = 1 ] &&
				[ "$state" = configured ] &&
				[ "$carrier" != 1 ] &&
				[ "$mode_reattach_since" -eq 0 ]; then
				mode_reattach_since=$now
				write_state mode_reattach_since "$mode_reattach_since"
				log_event "MODE_REATTACH mode=$mode state=configured carrier=$carrier"
			fi
			if [ "$mode_reattach_since" -gt 0 ] &&
				[ $((now - mode_reattach_since)) -ge "$mode_grace" ]; then
				if recover_link mode_transition; then
					write_state mode_reattach_since 0
				else
					write_state mode_reattach_since "$now"
					if [ "$(read_state attempts)" -ge "$max_attempts" ]; then
						write_state mode_reattach_since 0
					fi
				fi
			fi
		fi
		sleep "$interval"
	done
}

discover_udc

case ${1:-monitor} in
monitor) ;;
once)
	state=$(read_value "$udc_dir/$udc/state")
	carrier=$(read_value "$carrier_path")
	printf 'state=%s carrier=%s online=%s\n' \
		"$state" "$carrier" "$(read_value "$online_path")"
	;;
recover)
	mkdir -p "$run_dir"
	recover_link
	;;
status) status ;;
*) echo 'Usage: samurai-usb-recover monitor|once|recover|status' >&2; exit 2 ;;
esac

if [ "${1:-monitor}" = monitor ]; then
	monitor
fi
