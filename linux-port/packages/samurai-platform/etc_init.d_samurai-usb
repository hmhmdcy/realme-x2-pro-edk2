#!/sbin/openrc-run
description="Samurai CDC NCM with standard DHCP; retain the EUD channel"
depend() {
    need localmount
    after udev
}
start() {
    ebegin "Starting Samurai USB networking"
    /usr/sbin/samurai-usb start
    eend $?
}

stop() {
    ebegin "Stopping Samurai USB networking"
    /usr/sbin/samurai-usb stop
    eend $?
}
