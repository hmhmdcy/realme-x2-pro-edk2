package() {
 install -Dm755 "$srcdir"/usr_libexec_samurai-audio-route "$pkgdir"/usr/libexec/samurai-audio-route
 install -Dm755 "$srcdir"/usr_libexec_samurai-usb-sleep-guard "$pkgdir"/usr/libexec/samurai-usb-sleep-guard
 install -Dm644 "$srcdir"/etc_conf.d_samurai-sleep-inhibitor "$pkgdir"/etc/conf.d/samurai-sleep-inhibitor
 install -Dm755 "$srcdir"/etc_init.d_samurai-sleep-inhibitor "$pkgdir"/etc/init.d/samurai-sleep-inhibitor
 install -Dm644 "$srcdir"/etc_samurai_sleep-inhibitor.conf "$pkgdir"/etc/samurai/sleep-inhibitor.conf
 install -Dm755 "$srcdir"/usr_sbin_samurai-bluetooth "$pkgdir"/usr/sbin/samurai-bluetooth
 install -Dm755 "$srcdir"/usr_sbin_samurai-modem-configs "$pkgdir"/usr/sbin/samurai-modem-configs
 install -Dm755 "$srcdir"/usr_sbin_samurai-modem-remoteproc "$pkgdir"/usr/sbin/samurai-modem-remoteproc
 install -Dm755 "$srcdir"/usr_sbin_samurai-radio-address "$pkgdir"/usr/sbin/samurai-radio-address
 install -Dm755 "$srcdir"/usr_sbin_samurai-udhcpc-wlan "$pkgdir"/usr/sbin/samurai-udhcpc-wlan
 install -Dm755 "$srcdir"/usr_sbin_samurai-wifi "$pkgdir"/usr/sbin/samurai-wifi
 install -Dm755 "$srcdir"/usr_sbin_samurai-usb "$pkgdir"/usr/sbin/samurai-usb
 install -Dm755 "$srcdir"/etc_init.d_samurai-loopback "$pkgdir"/etc/init.d/samurai-loopback
 install -Dm755 "$srcdir"/etc_init.d_samurai-radio "$pkgdir"/etc/init.d/samurai-radio
 install -Dm755 "$srcdir"/etc_init.d_samurai-usb "$pkgdir"/etc/init.d/samurai-usb
 install -Dm644 "$srcdir"/etc_NetworkManager_conf.d_20-samurai-wlan.conf "$pkgdir"/etc/NetworkManager/conf.d/20-samurai-wlan.conf
 install -Dm644 "$srcdir"/etc_NetworkManager_conf.d_90-samurai-usb.conf "$pkgdir"/etc/NetworkManager/conf.d/90-samurai-usb.conf
 install -Dm644 "$srcdir"/usr_local_share_dbus-1_system-services_org.freedesktop.ModemManager1.service \
  "$pkgdir"/usr/local/share/dbus-1/system-services/org.freedesktop.ModemManager1.service
 install -Dm644 "$srcdir"/99-realme-rmx1931-sensors.rules "$pkgdir"/usr/lib/udev/rules.d/99-realme-rmx1931-sensors.rules
 install -Dm644 "$srcdir"/99-realme-rmx1931-haptics.rules "$pkgdir"/usr/lib/udev/rules.d/99-realme-rmx1931-haptics.rules
 install -Dm644 "$srcdir"/usr_share_alsa_ucm2_conf.d_Realme_X2_Pro_HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/conf.d/Realme_X2_Pro/HiFi.conf
 install -Dm644 "$srcdir"/usr_share_alsa_ucm2_conf.d_Realme_X2_Pro_Realme_X2_Pro.conf "$pkgdir"/usr/share/alsa/ucm2/conf.d/Realme_X2_Pro/Realme_X2_Pro.conf
}

pulse() {
 pkgdesc="PulseAudio defaults for Realme X2 Pro"
 depends="pulseaudio pulseaudio-bluez"
 install -Dm644 "$srcdir"/etc_pulse_daemon.conf.d_90-samurai.conf \
  "$subpkgdir"/etc/pulse/daemon.conf.d/90-samurai.conf
}

