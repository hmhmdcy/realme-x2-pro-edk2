maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-platform
pkgver=6
pkgrel=25
pkgdesc="Realme X2 Pro platform"
url="https://github.com/hmhmdcy/realme-x2-pro-pmaports"
arch="noarch"
license="LicenseRef-Local-Project"
# The ModemManager D-Bus service is an intentional distribution override
# in /usr/local; keep the package's existing install layout.
options="!check !fhs"
# The shipped image is systemd-based: keep this list identical to what the
# installed 6-r22 record carries.  `openrc`, `neard` and `neard-openrc` are
# OpenRC-era requirements that do not exist on this image, and listing them
# makes `apk add` refuse the upgrade with "no such package".
depends="python3 eudev iproute2 util-linux libqmi qmi-utils networkmanager
	bluez wpa_supplicant openssh-server-pam alsa-ucm-conf alsa-utils
	sleep-inhibitor dnsmasq usb-signaller>=0.4.3-r9 unudhcpd>=0.5.0-r2
	qrtr /bin/sh"
subpackages="$pkgname-pulse"
install="$pkgname.post-install"
# /etc/unudhcpd.conf is owned by postmarketos-initramfs and is read by the
# initramfs.  Writing it from this package made `apk upgrade` abort with
# "trying to overwrite etc/unudhcpd.conf owned by postmarketos-initramfs".
# The developer-mode address pair is delivered through the systemd drop-in
# (samurai-systemd/10-samurai-unudhcpd.conf) and OpenRC's /etc/conf.d, so
# the initramfs file stays untouched.
source="etc_pulse_daemon.conf.d_90-samurai.conf etc_pulse_client.conf.d_90-samurai.conf usr_sbin_samurai-bluetooth usr_sbin_samurai-modem-configs usr_sbin_samurai-modem-remoteproc usr_sbin_samurai-radio-address usr_sbin_samurai-wifi usr_sbin_samurai-usb-recover usr_sbin_samurai-usb-network-watchdog etc_init.d_samurai-radio etc_init.d_samurai-usb-recover etc_init.d_samurai-usb-network etc_NetworkManager_conf.d_20-samurai-wlan.conf etc_usb-signaller.d_90-samurai.toml etc_conf.d_unudhcpd usr_local_share_dbus-1_system-services_org.freedesktop.ModemManager1.service 99-realme-rmx1931-sensors.rules 99-realme-rmx1931-haptics.rules usr_share_alsa_ucm2_conf.d_Realme_X2_Pro_HiFi.conf usr_share_alsa_ucm2_conf.d_Realme_X2_Pro_Realme_X2_Pro.conf etc_samurai_usb-dhcp.conf 50-samurai-regdb.files"
package() {
 install -Dm755 "$srcdir"/usr_sbin_samurai-bluetooth "$pkgdir"/usr/sbin/samurai-bluetooth
 install -Dm755 "$srcdir"/usr_sbin_samurai-modem-configs "$pkgdir"/usr/sbin/samurai-modem-configs
 install -Dm755 "$srcdir"/usr_sbin_samurai-modem-remoteproc "$pkgdir"/usr/sbin/samurai-modem-remoteproc
 install -Dm755 "$srcdir"/usr_sbin_samurai-radio-address "$pkgdir"/usr/sbin/samurai-radio-address
 install -Dm755 "$srcdir"/usr_sbin_samurai-wifi "$pkgdir"/usr/sbin/samurai-wifi
 install -Dm755 "$srcdir"/usr_sbin_samurai-usb-recover "$pkgdir"/usr/sbin/samurai-usb-recover
 install -Dm755 "$srcdir"/usr_sbin_samurai-usb-network-watchdog "$pkgdir"/usr/sbin/samurai-usb-network-watchdog
 install -Dm755 "$srcdir"/etc_init.d_samurai-radio "$pkgdir"/etc/init.d/samurai-radio
 install -Dm755 "$srcdir"/etc_init.d_samurai-usb-recover "$pkgdir"/etc/init.d/samurai-usb-recover
 install -Dm755 "$srcdir"/etc_init.d_samurai-usb-network "$pkgdir"/etc/init.d/samurai-usb-network
 install -Dm644 "$srcdir"/etc_samurai_usb-dhcp.conf "$pkgdir"/etc/samurai/usb-dhcp.conf
 install -Dm644 "$srcdir"/etc_NetworkManager_conf.d_20-samurai-wlan.conf "$pkgdir"/etc/NetworkManager/conf.d/20-samurai-wlan.conf
 install -Dm644 "$srcdir"/etc_usb-signaller.d_90-samurai.toml "$pkgdir"/etc/usb-signaller.d/90-samurai.toml
 install -Dm644 "$srcdir"/etc_conf.d_unudhcpd "$pkgdir"/etc/conf.d/unudhcpd
 install -Dm644 "$srcdir"/usr_local_share_dbus-1_system-services_org.freedesktop.ModemManager1.service \
  "$pkgdir"/usr/local/share/dbus-1/system-services/org.freedesktop.ModemManager1.service
 install -Dm644 "$srcdir"/99-realme-rmx1931-sensors.rules "$pkgdir"/usr/lib/udev/rules.d/99-realme-rmx1931-sensors.rules
 install -Dm644 "$srcdir"/99-realme-rmx1931-haptics.rules "$pkgdir"/usr/lib/udev/rules.d/99-realme-rmx1931-haptics.rules
 install -Dm644 "$srcdir"/usr_share_alsa_ucm2_conf.d_Realme_X2_Pro_HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/conf.d/Realme_X2_Pro/HiFi.conf
 install -Dm644 "$srcdir"/usr_share_alsa_ucm2_conf.d_Realme_X2_Pro_Realme_X2_Pro.conf "$pkgdir"/usr/share/alsa/ucm2/conf.d/Realme_X2_Pro/Realme_X2_Pro.conf
 # cfg80211 asks for regulatory.db during kernel_init, before the f2fs root is
 # mounted, so the db must be inside the initramfs.  mkinitfs reads every
 # *.files under /etc/mkinitfs/files-extra/.
 install -Dm644 "$srcdir"/50-samurai-regdb.files \
  "$pkgdir"/etc/mkinitfs/files-extra/50-samurai-regdb.files
}

pulse() {
 pkgdesc="PulseAudio defaults for Realme X2 Pro"
 depends="pulseaudio pulseaudio-bluez"
 install -Dm644 "$srcdir"/etc_pulse_daemon.conf.d_90-samurai.conf \
  "$subpkgdir"/etc/pulse/daemon.conf.d/90-samurai.conf
 install -Dm644 "$srcdir"/etc_pulse_client.conf.d_90-samurai.conf \
  "$subpkgdir"/etc/pulse/client.conf.d/90-samurai.conf
}

