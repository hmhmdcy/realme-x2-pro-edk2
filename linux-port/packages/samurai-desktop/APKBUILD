maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-desktop
pkgver=4
pkgrel=11
pkgdesc="Realme X2 Pro Plasma Mobile defaults"
url="https://github.com/hmhmdcy/pmaports"
arch="noarch"
license="LicenseRef-Local-Project"
options="!check"
depends="postmarketos-ui-plasma-mobile tinydm samurai-platform
	modemmanager bluez
	samurai-platform-pulse calls chatty
	mmsd-tng callaudiod xdg-desktop-portal-kde kscreen python3 elogind"
install="$pkgname.post-install"
source="samurai-powerkey samurai-powerkey.openrc samurai-tinydm-stop"

package() {
	install -d "$pkgdir"/usr/share/samurai
	cat >"$pkgdir"/usr/share/samurai/plasma-mobile <<-EOF
		session=/usr/share/wayland-sessions/plasma-mobile.desktop
		backend=tinydm
		policy=plasma-defaults
	EOF
	install -Dm755 "$srcdir"/samurai-powerkey \
		"$pkgdir"/usr/libexec/samurai-powerkey
	install -Dm755 "$srcdir"/samurai-powerkey.openrc \
		"$pkgdir"/etc/init.d/samurai-powerkey
	install -Dm755 "$srcdir"/samurai-tinydm-stop \
		"$pkgdir"/usr/libexec/samurai-tinydm-stop
}

