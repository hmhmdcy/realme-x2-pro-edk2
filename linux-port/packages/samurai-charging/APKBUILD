maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-charging
pkgver=0.1.0
pkgrel=2
pkgdesc="Legacy Realme X2 Pro managed MP2650 charging experiment"
url="https://github.com/hmhmdcy/edk2-realme-x2-pro"
arch="aarch64"
license="LicenseRef-Local-Project"
options="!check"
depends="kmod python3 openrc"
install="$pkgname.post-install"
source="samurai-charging
	samurai-charging.initd
	samurai-charging.post-install
	installed-manifest.json
	artifacts/samurai-mp2650.ko
	artifacts/samurai-usb-input.ko
	artifacts/samurai-gauge-protection.ko"

package() {
	install -Dm755 "$srcdir"/samurai-charging \
		"$pkgdir"/usr/sbin/samurai-charging
	install -Dm755 "$srcdir"/samurai-charging.initd \
		"$pkgdir"/etc/init.d/samurai-charging
	install -Dm644 "$srcdir"/installed-manifest.json \
		"$pkgdir"/usr/share/samurai-charging/manifest.json
	for module in samurai-mp2650 samurai-usb-input samurai-gauge-protection; do
		install -Dm644 "$srcdir"/artifacts/$module.ko \
			"$pkgdir"/lib/modules/7.3.0-rc6-rmx1931-samurai-k363+/extra/samurai-charging/$module.ko
	done
}

