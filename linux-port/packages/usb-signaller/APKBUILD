maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=usb-signaller
pkgver=0.4.3
# Local board-descriptor, network-recovery, activation-retry and
# host-role service-lifecycle backport; upstream 0.4.3-r0 remains the
# baseline.
pkgrel=9
pkgdesc="Switch between different USB gadgets"
url="https://codeberg.org/DylanVanAssche/usb-signaller"
arch="all"
license="GPL-3.0-or-later"
source="$pkgname-$pkgver.tar.gz::https://codeberg.org/DylanVanAssche/usb-signaller/archive/v$pkgver.tar.gz
	usb-signaller.initd
	0001-gadget-support-board-descriptor-overrides.patch
	0002-usb-signaller-network-ownership.patch
	0003-usb-signaller-wait-for-network.patch
	0004-usb-signaller-retry-mode-activation.patch
	0005-usb-signaller-preserve-mode-on-incomplete-enumeration.patch
	0006-usb-signaller-stop-mode-services-before-host-role.patch
	0007-usb-signaller-tolerate-missing-netdev-on-mode-stop.patch
	0008-usb-signaller-retry-mode-service-start.patch
"
makedepends="cargo-auditable eudev-dev"
subpackages="$pkgname-systemd $pkgname-openrc"
options="net"
builddir="$srcdir/$pkgname"

prepare() {
	default_prepare
	cargo fetch --target="$CHOST" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/usb-signaller "$pkgdir"/usr/bin/usb-signaller

	for f in "$srcdir"/usb-signaller.initd distro/openrc/*.initd; do
		install -Dm755 "$f" "$pkgdir"/etc/init.d/"$(basename "$f" .initd)"
	done
	for f in *.service distro/systemd/*.service; do
		install -Dm644 "$f" "$pkgdir"/usr/lib/systemd/system/"$(basename "$f")"
	done
	for f in distro/scripts/*.sh; do
		install -Dm755 "$f" "$pkgdir"/usr/bin/"$(basename "$f" .sh)"
	done

	install -Dm644 com.meego.usb_moded.conf \
		-t "$pkgdir"/usr/share/dbus-1/system.d/
}

