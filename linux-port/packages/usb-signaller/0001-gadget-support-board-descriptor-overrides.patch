+            gadget: Some(merged_gadget),
         });
     }
 
@@ -108,4 +225,28 @@ impl Configuration {
             }
         }
     }
+
+    /*
+     * Board-specific USB descriptor overrides. Mode strings map to the
+     * corresponding [gadget.<mode>] table in usb-signaller.toml drop-ins.
+     */
+    pub fn get_gadget_configuration(mode: &str) -> Result<GadgetConfiguration> {
+        let config = Self::read()?;
+        let gadget = config.gadget.unwrap_or_default();
+        let mode = gadget.for_mode(mode).unwrap_or_default();
+
+        return Ok(GadgetConfiguration {
+            id_vendor: mode.id_vendor,
+            id_product: mode.id_product,
+            manufacturer: gadget.manufacturer,
+            product: mode.product,
+            serialnumber: gadget.serialnumber,
+            configuration: mode.configuration,
+            device_class: mode.device_class,
+            device_subclass: mode.device_subclass,
+            device_protocol: mode.device_protocol,
+            max_power: mode.max_power,
+            ncm_qmult: mode.ncm_qmult,
+        });
+    }
 }
