+                        let function_name = function
+                            .map(|f| f.name.as_str())
+                            .unwrap_or("<no configuration function>");
                         mode = UDCMode::Unknown;
                         eprintln!(
                             "❌ Cannot determine mode for gadget function {}",
-                            entry.configs[0].functions[0].name
+                            function_name
                         );
                     }
                 }
