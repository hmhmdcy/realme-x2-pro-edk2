+/* Effective gadget settings for one mode after merging all drop-in files. */
+#[derive(Debug, Default, Clone)]
+pub struct GadgetConfiguration {
+    pub id_vendor: Option<u16>,
+    pub id_product: Option<u16>,
+    pub manufacturer: Option<String>,
+    pub product: Option<String>,
+    pub serialnumber: Option<String>,
+    pub configuration: Option<String>,
+    pub device_class: Option<u8>,
+    pub device_subclass: Option<u8>,
+    pub device_protocol: Option<u8>,
+    pub max_power: Option<u16>,
+    pub ncm_qmult: Option<u8>,
+}
+
+impl GadgetModeConfiguration {
+    fn merge(&mut self, other: GadgetModeConfiguration) {
+        if other.id_vendor.is_some() {
+            self.id_vendor = other.id_vendor;
+        }
+        if other.id_product.is_some() {
+            self.id_product = other.id_product;
+        }
+        if other.product.is_some() {
+            self.product = other.product;
+        }
+        if other.configuration.is_some() {
+            self.configuration = other.configuration;
+        }
+        if other.device_class.is_some() {
+            self.device_class = other.device_class;
+        }
+        if other.device_subclass.is_some() {
+            self.device_subclass = other.device_subclass;
+        }
+        if other.device_protocol.is_some() {
+            self.device_protocol = other.device_protocol;
+        }
+        if other.max_power.is_some() {
+            self.max_power = other.max_power;
+        }
+        if other.ncm_qmult.is_some() {
+            self.ncm_qmult = other.ncm_qmult;
+        }
+    }
+}
+
+impl GadgetFileConfiguration {
+    fn merge(&mut self, other: GadgetFileConfiguration) {
+        if other.manufacturer.is_some() {
+            self.manufacturer = other.manufacturer;
+        }
+        if other.serialnumber.is_some() {
+            self.serialnumber = other.serialnumber;
+        }
+        merge_gadget_mode(&mut self.developer, other.developer);
+        merge_gadget_mode(&mut self.tethering, other.tethering);
+        merge_gadget_mode(&mut self.mtp, other.mtp);
+        merge_gadget_mode(&mut self.accessory, other.accessory);
+        merge_gadget_mode(&mut self.mass_storage, other.mass_storage);
+    }
+
+    fn for_mode(&self, mode: &str) -> Option<GadgetModeConfiguration> {
+        match mode {
+            "developer" => self.developer.clone(),
+            "tethering" => self.tethering.clone(),
+            "mtp" => self.mtp.clone(),
+            "accessory" => self.accessory.clone(),
+            "mass_storage" => self.mass_storage.clone(),
+            _ => None,
+        }
+    }
+}
+
+fn merge_gadget_mode(
+    destination: &mut Option<GadgetModeConfiguration>,
+    source: Option<GadgetModeConfiguration>,
+) {
+    if let Some(source) = source {
+        match destination {
+            Some(destination) => destination.merge(source),
+            None => *destination = Some(source),
+        }
+    }
+}
