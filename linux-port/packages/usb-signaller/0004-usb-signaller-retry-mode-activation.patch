+}
+
 activate_connection() {
     count=0
-    while [ "$count" -lt 10 ]; do
+    while [ "$count" -lt 30 ]; do
         if nmcli connection up "$CONNECTION_NAME" >/dev/null 2>&1; then
             return 0
         fi
@@ -37,7 +49,8 @@ up() {
     # The host can take a moment to create the NCM netdev and raise carrier
     # after a gadget rebind. Do not make the mode service fail prematurely.
     wait_for_interface || true
-    nmcli device set "$IFACE" managed yes >/dev/null 2>&1 || true
+    ensure_managed ||
+        echo "NetworkManager did not accept $IFACE as managed"
 
     # Clean up possible left-over
     nmcli connection delete "$CONNECTION_NAME" >/dev/null 2>&1 || true
