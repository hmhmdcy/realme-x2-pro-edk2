maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-systemd
pkgver=1
pkgrel=5
pkgdesc="Realme X2 Pro systemd unit glue for the board service layer"
url="https://github.com/hmhmdcy/realme-x2-pro-pmaports"
arch="noarch"
license="MIT"
depends="systemd samurai-platform samurai-ssc"
makedepends=""
install="$pkgname.post-install"

# These are the exact units this port ships. They are plain text so the
# package is reproducible from source; nothing here is generated by a build.
source="
	samurai-gnss-assist.service
	samurai-radio.service
	samurai-ssc.service
	samurai-usb-network.service
	samurai-usb-recover.service
	50-samurai.preset
	10-samurai.conf
	10-samurai-iio.conf
	10-samurai-unudhcpd.conf
	10-board.conf
	samurai-radio-start
	"

package() {
	install -Dm644 "$srcdir"/samurai-gnss-assist.service \
		"$pkgdir"/usr/lib/systemd/system/samurai-gnss-assist.service
	install -Dm644 "$srcdir"/samurai-radio.service \
		"$pkgdir"/usr/lib/systemd/system/samurai-radio.service
	install -Dm644 "$srcdir"/samurai-ssc.service \
		"$pkgdir"/usr/lib/systemd/system/samurai-ssc.service
	install -Dm644 "$srcdir"/samurai-usb-network.service \
		"$pkgdir"/usr/lib/systemd/system/samurai-usb-network.service
	install -Dm644 "$srcdir"/samurai-usb-recover.service \
		"$pkgdir"/usr/lib/systemd/system/samurai-usb-recover.service
	install -Dm644 "$srcdir"/50-samurai.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/50-samurai.preset
	install -Dm644 "$srcdir"/10-samurai.conf \
		"$pkgdir"/usr/lib/systemd/system/bluetooth.service.d/10-samurai.conf
	install -Dm644 "$srcdir"/10-samurai-iio.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-samurai.conf
	install -Dm644 "$srcdir"/10-samurai-unudhcpd.conf \
		"$pkgdir"/usr/lib/systemd/system/unudhcpd@usb0.service.d/10-samurai.conf
	install -Dm644 "$srcdir"/10-board.conf \
		"$pkgdir"/usr/lib/systemd/system/usb-signaller.service.d/10-board.conf
	install -Dm755 "$srcdir"/samurai-radio-start \
		"$pkgdir"/usr/libexec/samurai/samurai-radio-start

	# systemd opens StandardOutput=append: files before ExecStartPre runs,
	# so the GNSS log directory must exist in the package itself.
	install -d -m 0700 "$pkgdir"/var/lib/samurai/gnss-assist
}

