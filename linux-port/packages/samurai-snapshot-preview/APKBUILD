b610eff5a9c52bac51e75e07201c9bebb8e28696d7aa8f2e5b5e673b28acdabd774c4acc5e490a7b8c582d7643e33b1607842eb896f4b5b552918166ea163bc7  60-samurai-camera-names.conf
