maintainer="hmhmdcy <hmhmdcy@users.noreply.github.com>"
pkgname=samurai-snapshot-preview
pkgver=0.1.0
pkgrel=3
pkgdesc="Realme X2 Pro camera labels and Snapshot preview caps preference"
url="https://github.com/hmhmdcy/edk2-realme-x2-pro"
arch="aarch64"
license="LicenseRef-Local-Project"
depends="glib gst-plugins-base gstreamer wireplumber"
makedepends="gcc musl-dev pkgconf gstreamer-dev"
install="$pkgname.post-install"
options="!check"
source="samsinkinject.c
	samucapsinject.c
	60-samurai-camera-names.conf
	99-samurai-snapshot-camera.gschema.override"

builddir="$srcdir"

build() {
	gcc -shared -fPIC -O2 -Wall -Wextra \
		-o samsinkinject.so samsinkinject.c \
		$(pkg-config --cflags --libs gstreamer-1.0 gobject-2.0)
	gcc -shared -fPIC -O2 -Wall -Wextra \
		-o samucapsinject.so samucapsinject.c \
		$(pkg-config --cflags --libs gstreamer-1.0 gobject-2.0)
}

package() {
	install -Dm755 "$builddir"/samsinkinject.so \
		"$pkgdir"/usr/lib/samsinkinject.so
	install -Dm755 "$builddir"/samucapsinject.so \
		"$pkgdir"/usr/lib/samucapsinject.so
	install -Dm644 "$srcdir"/60-samurai-camera-names.conf \
		"$pkgdir"/etc/wireplumber/wireplumber.conf.d/60-samurai-camera-names.conf
	install -Dm644 "$srcdir"/99-samurai-snapshot-camera.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/99_samurai-snapshot-camera.gschema.override
}

