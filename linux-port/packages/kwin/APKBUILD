subpackages="$pkgname-systemd $pkgname-dbg $pkgname-dev $pkgname-lang $pkgname-doc"
source="https://invent.kde.org/plasma/kwin/-/archive/v$pkgver/kwin-v$pkgver.tar.gz
	0101-dpms-cancel-touch-sequences.patch
	0102-ignore-dpms-wakeups-before-sleep.patch
	"
builddir="$srcdir/kwin-v$pkgver"
options="setcap !check"

build() {
	cc1dir=$(dirname "$(find /usr/libexec/gcc/aarch64-alpine-linux-musl \
		-name cc1 -print -quit)")
	export COMPILER_PATH="$cc1dir${COMPILER_PATH:+:$COMPILER_PATH}"

	if [ -d /native/usr/lib/gcc/aarch64-alpine-linux-musl ]; then
		gccdir=$(dirname "$(find /native/usr/lib/gcc/aarch64-alpine-linux-musl \
			-name crtbeginS.o -print -quit)")
		export LIBRARY_PATH="$gccdir${LIBRARY_PATH:+:$LIBRARY_PATH}"
	fi

	CFLAGS="$CFLAGS -O2 -g1 -fno-use-linker-plugin" \
	CXXFLAGS="$CXXFLAGS -O2 -g1 -fno-use-linker-plugin" \
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

